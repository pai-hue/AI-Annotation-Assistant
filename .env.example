# Local YOLO detect (primary prelabel path). DASHSCOPE_API_KEY is unused for prelabel
# after Qwen retirement; you may keep an old key in .env but FramePilot will not call Alibaba.
# # Put .pt files under server/models/ (subfolders OK). Side panel M5.5 lists/switches them.
YOLO_MODEL_PATH=server/models/model_20261027_232748.pt
# Put .pt files under server/models/ (subfolders OK). Side panel M5.5 lists/switches them.
YOLO_MODEL_PATH=server/models/model_20261027_232748.pt
YOLO_CONF=0.25
YOLO_IOU=0.45
YOLO_DEVICE=0

# Optional legacy (not used by prelabel):
# DASHSCOPE_API_KEY=
# QWEN_MODEL=qwen3-vl-flash
